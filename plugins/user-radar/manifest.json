{
  "format": 1,
  "id": "mydiscordstuff.user-radar",
  "name": "UserRadar",
  "description": "Alertas de atividade do Discord no Android, com lista por ID, histórico local e horário silencioso.",
  "author": "mydiscordstuff (https://github.com/mydiscordstuff)",
  "contributors": [
    "k1ng0p (https://github.com/k1ng0p/UserRadar \"UserRadar original para Vencord\")"
  ],
  "icon": "BellIcon",
  "version": "1.0.0",
  "dependencies": {
    "valenced.api": {
      "version": ">=1 <2"
    },
    "discord": {
      "version": ">=352.2"
    },
    "valenced.settings": {}
  },
  "dist": {
    "script": "index.js",
    "android": {
      "path": "plugin.jar",
      "class": "mydiscordstuff.radar.AndroidPlugin"
    }
  }
}
